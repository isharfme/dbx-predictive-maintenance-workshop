# Copy this file to .env and fill in the values, then run ./deploy.sh.
# .env is gitignored and must never be committed.

# --- Required ---------------------------------------------------------------
# Locally authenticated AWS CLI/SSO profile (run `aws sso login --profile ...`).
AWS_PROFILE=
# Region for all AWS resources, e.g. us-east-2.
AWS_REGION=
# ~/.databrickscfg profile for the target workspace (databricks scope only).
# Its account ID (from `databricks auth login`) is read for the IAM trust policy.
DATABRICKS_PROFILE=

# --- Optional overrides (blank = deploy.sh/Terraform picks a default) -------
# Existing Unity Catalog the workshop reads and writes under. Default:
# pdm_ws_catalog. Must already exist. Set the SAME catalog in each notebook's
# CATALOG constant too — notebooks run on Databricks and can't read this file.
# CATALOG=
# Owner tag. Default: your `git config user.email`.
# OWNER_EMAIL=
# RemoveAfter tag, YYYY-MM-DD. Default: 30 days from the deploy date.
# REMOVE_AFTER=
# UC group or user granted read access to the flows.
# Default: the deploying Databricks user.
# WORKSHOP_PRINCIPAL=
# Suffix for the S3 bucket name only if the global name is already taken.
# BUCKET_SUFFIX=
